# ==============================================================================
# Belajar-Ku Backend Environment Variables (Template / Example)
# ==============================================================================

# Node runtime environment (development, production, test)
NODE_ENV=development

# HTTP server port & host binding (0.0.0.0 required for Docker containers)
PORT=5000
HOST=0.0.0.0

# PostgreSQL Database Connection URL
# For Docker Compose: postgresql://postgres:postgres@postgres:5432/belajarku?schema=public
# For Bare Metal Local: postgresql://postgres:postgres@localhost:5432/belajarku?schema=public
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/belajarku?schema=public"

# Redis Connection URL
# For Docker Compose: redis://redis:6379
# For Bare Metal Local: redis://localhost:6379
REDIS_URL="redis://redis:6379"

# JWT Secret for access token signing & verification (minimum 16 characters)
JWT_SECRET="belajarku_super_secret_jwt_key_demo_2026"

# Frontend URL (for redirects and primary client origin)
FRONTEND_URL="http://localhost:3000"

# Allowed CORS Origins (comma-separated list for local development, Cloudflare tunnels, and Vercel production)
CORS_ORIGIN="http://localhost:3000,https://belajar-ku-six.vercel.app"
