# ==============================================================================
# Belajar-Ku Frontend Environment Variables
# ==============================================================================

# Public API URL accessible from the user's browser (Required)
# Local Docker Dev: http://localhost:5000
# Production: https://api.belajarku.com (or your deployed Fastify API URL on Railway/Render/Fly.io/VPS)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional Server-Side Internal URL (used during SSR or rewrites)
# Local Docker Dev: http://api:5000
# Production: https://api.belajarku.com
INTERNAL_API_URL=http://localhost:5000
