# ==============================================================================
# Belajar-Ku Frontend Environment Variables (Template / Example)
# ==============================================================================

# Public API URL accessible from the user's browser (Required)
# Local Docker Dev & Bare Metal: http://localhost:5000
# Production / Remote Tunnel: https://api.belajarku.com or Cloudflare Tunnel URL
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Server-Side Internal URL (used during Next.js SSR rewrites / internal container network)
# Local Docker Dev: http://api:5000
# Bare Metal Local: http://localhost:5000
# Production: http://api:5000
INTERNAL_API_URL="http://api:5000"
